{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "charis",
  "version": "0.1.0",
  "identifier": "com.charis.viewer",
  "build": {
    "frontendDist": "../../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "charis - 5ch Dedicated Browser",
        "width": 1360,
        "height": 880,
        "resizable": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  }
}

